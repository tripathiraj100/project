    <h3><%= listing.title %></h3>
    <img src="<%= listing.image && listing.image.url ? listing.image.url : listing.image %>" class="card-img-top show-img mb-3" alt="listing_image" style="height: 30vh; object-fit: cover; border-radius: 1rem;">
    <div class="card-body">
